{
  "name": "@benjypng/logseq-dateutils",
  "version": "2.1.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjypng/logseq-dateutils.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "analyze": "size-limit --why",
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "prepare": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "size": "size-limit",
    "start": "tsdown src/index.ts --format esm,cjs --dts --watch",
    "test": "TZ=Asia/Singapore bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "logseq",
    "scheduled",
    "deadline",
    "date",
    "utilities"
  ],
  "license": "MIT",
  "author": "hkgnp",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "release": {
    "branches": [
      "main"
    ]
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "engines": {
    "node": ">=12"
  },
  "size-limit": [
    {
      "path": "dist/index.cjs",
      "limit": "10 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^9.0.0",
    "@tsconfig/recommended": "^1.0.7",
    "@types/bun": "^1.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "date-fns": "^2.30.0"
  }
}
